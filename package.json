{
  "name": "orange-hrm-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript capstone for OrangeHRM authentication and employee CRUD",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "allure generate allure-results --clean -o allure-report",
    "test:report:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.3.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.8.3"
  }
}
